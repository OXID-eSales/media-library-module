<!DOCTYPE html>
<html>
<head>
    <title>MediaLibrary</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="user-scalable=no, width=device-width, initial-scale=1, maximum-scale=1">

    <link href='//fonts.googleapis.com/css?family=Open+Sans:300,400,700' rel='stylesheet' type='text/css'>

    {% set oViewConf = oView.getViewConfig() %}

    {{ style({ include: oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/css/bootstrap.min.css') }) }}
    {{ style({ include: oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/css/font-awesome.min.css') }) }}
    {{ style({ include: oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/css/base.min.css') }) }}
    {{ style({ include: oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/css/medialibrary.min.css') }) }}

    {{ style() }}
</head>
<body class="dd-media-wrapper">
    <nav class="navbar bg-body-tertiary dd-navbar">
        <div class="container-fluid">

            <div class="navbar-header">
                <a class="navbar-brand" href="javascript:void(null);">
                    {{ translate({ ident: "DD_MEDIA_DIALOG" }) }}
                </a>
            </div>

            {% if not request.isPopout() %}
                <ul class="nav navbar-nav navbar-right hidden-xs">
                    <li><a href="{{ oViewConf.getSelfLink()|replace({'&amp;':'&'})|raw }}cl={{ oViewConf.getActiveClassName() }}&popout=1" target="_blank" class="dd-admin-popout-action"><i class="fa fa-expand"></i></a></li>
                </ul>
            {% endif %}

        </div>
    </nav>

    <div class="dd-content">
        {% include "@ddoemedialibrary/dialog/ddoemedia.html.twig" %}
    </div>

    {% set sActionLink = oViewConf.getSelfLink()|replace({'&amp;':'&'}) %}
    {% set sMediaLink = oConf.getCurrentShopUrl(true)|regex_replace('/([^\/])(\/admin)/', '$1')|regex_replace('/http(s)?\, /', '')|trim('/', 'right')|cat('/out/pictures/ddmedia/') %}
    <script type="module">
        (async () => {
            try {
                await import("{{ oViewConf.getSelfLink()|replace({'&amp;':'&'})|cat('cl=ddoelangjs')|raw }}");
                await import("{{ oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/js/jquery.min.js') }}");
                await import("{{ oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/js/jquery-ui.min.js') }}");
                await import("{{ oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/js/bootstrap.min.js') }}");

                const { MediaLibrary } = await import("{{ oViewConf.getModuleUrl('ddoemedialibrary', 'out/src/js/base.min.js') }}");

                MediaLibrary.setActionLink("{{ sActionLink|raw }}");
                MediaLibrary.setResourceLink("{{ sMediaLink }}");
                const regexPattern = new RegExp("image/.*", "i");
                MediaLibrary.init(regexPattern, null);
            } catch (error) {
                console.error("Failed to load Media Library script:", error);
            }
        })();
    </script>

</body>
</html>
